# Copia este archivo como .env y completa los valores. El .env real no se sube a git.

# Cadena de conexion de Postgres (Neon). Vacia = base local embebida (PGlite) en .pglite/
DATABASE_URL=

# Secreto para firmar las sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
